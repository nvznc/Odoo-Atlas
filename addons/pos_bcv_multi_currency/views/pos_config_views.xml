<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_bcv" model="ir.ui.view">
        <field name="name">pos.config.form.bcv</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']" position="after">
                <page string="BCV" name="bcv">
                    <group>
                        <group string="Cobro en bolívares">
                            <field name="bcv_enabled"/>
                            <field name="bcv_currency_id" options="{'no_create': True}" invisible="not bcv_enabled"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="not bcv_enabled">
                        La tasa se toma de la última tasa BCV disponible al abrir la sesión.
                        Cada pedido conserva la tasa con la que fue cobrado.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
