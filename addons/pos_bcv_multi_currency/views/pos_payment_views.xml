<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_bcv" model="ir.ui.view">
        <field name="name">pos.payment.form.bcv</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_currency_id" options="{'no_create': True}"/>
                <field name="payment_amount" widget="monetary"/>
                <field name="payment_rate"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_tree_bcv" model="ir.ui.view">
        <field name="name">pos.payment.list.bcv</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_currency_id" optional="hide"/>
                <field name="payment_amount" optional="hide"/>
                <field name="payment_rate" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
