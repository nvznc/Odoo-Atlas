<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="after">
            <div t-if="currentOrder.hasBcv" class="text-center text-muted mt-1"
                t-att-style="!ui.isSmall ? 'font-size: 3rem;' : 'font-size: 1.5rem;'">
                <t t-esc="currentOrder.bcvRemainingDueDisplay"/>
            </div>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-amount')]/PriceFormatter" position="before">
            <div t-if="line.isVes()" class="text-end lh-sm">
                <div t-esc="line.formattedPaymentAmount"/>
                <small class="text-muted" t-esc="line.formattedUsdAmount"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('payment-amount')]/PriceFormatter" position="attributes">
            <attribute name="t-if">!line.isVes()</attribute>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-container')]" position="after">
            <div t-if="order.hasBcv and order.payment_ids.length and !isRemaining"
                class="payment-status-bcv d-flex justify-content-between align-items-baseline text-muted fs-4 pt-1 pe-5 me-5">
                <span>Change Bs</span>
                <span class="fw-bold" t-out="order.bcvChangeDisplay"/>
            </div>
        </xpath>
    </t>
</templates>
