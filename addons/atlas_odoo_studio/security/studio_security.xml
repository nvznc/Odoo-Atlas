<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_studio_designer" model="res.groups">
        <field name="name">Atlas Studio / Diseñador</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_studio_customization_company" model="ir.rule">
        <field name="name">Atlas Studio: personalizaciones por compañía</field>
        <field name="model_id" ref="model_studio_customization"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_studio_designer'))]"/>
    </record>

    <record id="rule_studio_operation_company" model="ir.rule">
        <field name="name">Atlas Studio: operaciones por compañía</field>
        <field name="model_id" ref="model_studio_operation"/>
        <field name="domain_force">[('customization_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_studio_designer'))]"/>
    </record>

    <record id="rule_studio_audit_company" model="ir.rule">
        <field name="name">Atlas Studio: auditoría por compañía</field>
        <field name="model_id" ref="model_studio_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_studio_designer'))]"/>
    </record>
</odoo>
