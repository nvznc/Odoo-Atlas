<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_customization_tree" model="ir.ui.view">
        <field name="name">studio.customization.tree</field>
        <field name="model">studio.customization</field>
        <field name="arch" type="xml">
            <list string="Personalizaciones" create="0">
                <field name="name"/>
                <field name="model_name"/>
                <field name="view_type"/>
                <field name="version"/>
                <field name="state" widget="badge"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_studio_customization_form" model="ir.ui.view">
        <field name="name">studio.customization.form</field>
        <field name="model">studio.customization</field>
        <field name="arch" type="xml">
            <form string="Personalización">
                <header>
                    <button name="action_apply" type="object" string="Reaplicar" class="btn-primary"/>
                    <button name="action_archive" type="object" string="Archivar"/>
                    <button name="action_restore" type="object" string="Restaurar"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="model_name"/>
                            <field name="view_type"/>
                        </group>
                        <group>
                            <field name="base_view_id"/>
                            <field name="extension_view_id"/>
                            <field name="version"/>
                            <field name="company_id"/>
                            <field name="last_applied"/>
                            <field name="applied_by_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="operation_ids" readonly="1">
                        <list>
                            <field name="sequence"/>
                            <field name="op_type"/>
                            <field name="target_xpath"/>
                            <field name="position"/>
                            <field name="state"/>
                            <field name="error"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_studio_audit_log_tree" model="ir.ui.view">
        <field name="name">studio.audit.log.tree</field>
        <field name="model">studio.audit.log</field>
        <field name="arch" type="xml">
            <list string="Auditoría" create="0" edit="0" delete="0">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="details"/>
            </list>
        </field>
    </record>

    <record id="action_studio_customization" model="ir.actions.act_window">
        <field name="name">Personalizaciones</field>
        <field name="res_model">studio.customization</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <record id="action_studio_audit_log" model="ir.actions.act_window">
        <field name="name">Auditoría</field>
        <field name="res_model">studio.audit.log</field>
        <field name="view_mode">list</field>
        <field name="target">current</field>
    </record>
</odoo>
