<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_config_view_form_jiotbox" model="ir.ui.view">
        <field name="name">pos.config.form.jiotbox</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='other_devices']//field[@name='epson_printer_ip']"
                position="after"
            >
                <field
                    name="jiotbox_customer_receipt_url"
                    placeholder="https://192.168.1.50:8443/receipt"
                    class="w-100 pt-1"
                />
            </xpath>
        </field>
    </record>
</odoo>
