<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_jiotbox" model="ir.ui.view">
        <field name="name">res.config.settings.form.jiotbox</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='pos_other_devices']//field[@name='pos_epson_printer_ip']"
                position="after"
            >
                <field
                    name="pos_jiotbox_customer_receipt_url"
                    placeholder="https://192.168.1.50:8443/receipt"
                    class="w-100 pt-1"
                />
            </xpath>
            <xpath
                expr="//setting[@id='pos_other_devices']//div[@role='alert']"
                position="after"
            >
                <div
                    role="alert"
                    class="alert alert-warning"
                    invisible="not pos_other_devices or pos_jiotbox_customer_receipt_url in [False, ''] or pos_epson_printer_ip in [False, '']"
                >
                    jIotBox will be used for the customer receipt instead of the Epson printer.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
