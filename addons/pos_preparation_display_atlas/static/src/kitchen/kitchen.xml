<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_preparation_display_atlas.PreparationDisplay">
        <div class="o_prep_display">
            <header class="o_prep_header">
                <div class="o_prep_title">
                    <span class="o_prep_title_name" t-esc="state.display.name"/>
                    <span class="o_prep_title_hint">Pedidos en preparación</span>
                </div>
                <nav class="o_prep_stages">
                    <button
                        class="o_prep_stage_tab"
                        t-att-class="{ selected: selectedStageId === 0 }"
                        t-on-click="() => this.selectStage(0)"
                    >
                        Todos
                        <span class="o_prep_badge" t-esc="state.orders.length"/>
                    </button>
                    <button
                        t-foreach="stages"
                        t-as="stage"
                        t-key="stage.id"
                        class="o_prep_stage_tab"
                        t-att-class="{ selected: selectedStageId === stage.id }"
                        t-attf-style="--stage-color: {{ stage.color }};"
                        t-on-click="() => this.selectStage(stage.id)"
                    >
                        <span class="o_prep_stage_dot"/>
                        <t t-esc="stage.name"/>
                        <span class="o_prep_badge" t-esc="this.stageCount(stage.id)"/>
                    </button>
                </nav>
                <div class="o_prep_header_actions">
                    <button class="btn btn-outline-light" t-on-click="resetAll">
                        Reiniciar todo
                    </button>
                </div>
            </header>

            <main class="o_prep_board">
                <div t-if="state.loading" class="o_prep_empty">
                    Cargando pedidos…
                </div>
                <div t-elif="!visibleOrders.length" class="o_prep_empty">
                    No hay pedidos en esta etapa.
                </div>
                <div t-else="" class="o_prep_grid">
                    <OrderCard
                        t-foreach="visibleOrders"
                        t-as="order"
                        t-key="order.id + '-' + order.stage_id"
                        order="order"
                        now="state.now"
                    />
                </div>
            </main>
        </div>
    </t>

    <t t-name="pos_preparation_display_atlas.OrderCard">
        <article
            class="o_prep_card"
            t-att-class="{ 'o_prep_card_late': isLate, 'o_prep_card_completed': isCompleted }"
            t-on-click="advance"
        >
            <header class="o_prep_card_header">
                <div>
                    <div class="o_prep_card_number" t-esc="order.name"/>
                    <div class="o_prep_card_meta">
                        <span t-if="order.table">Mesa <t t-esc="order.table"/></span>
                        <span t-if="order.customer_count">· <t t-esc="order.customer_count"/> pers.</span>
                    </div>
                </div>
                <div class="o_prep_card_timer">
                    <span t-esc="elapsedLabel"/>
                </div>
            </header>

            <div class="o_prep_card_stage">
                <span
                    class="o_prep_stage_pill"
                    t-attf-style="background-color: {{ order.stage_color }};"
                    t-esc="order.stage_name"
                />
            </div>

            <div class="o_prep_lines">
                <div
                    t-foreach="lines"
                    t-as="line"
                    t-key="line.state_id"
                    class="o_prep_line"
                    t-att-class="{ 'o_prep_line_done': !line.todo, 'o_prep_line_child': line.combo_parent_id }"
                    t-on-click.stop="() => this.toggleLine(line)"
                >
                    <div class="o_prep_line_qty" t-esc="line.quantity + '×'"/>
                    <div class="o_prep_line_body">
                        <div class="o_prep_line_product" t-esc="line.product"/>
                        <div t-if="line.attributes.length" class="o_prep_line_attributes">
                            <span
                                t-foreach="line.attributes"
                                t-as="attribute"
                                t-key="attribute.attribute + attribute.value"
                            >
                                <t t-esc="attribute.attribute"/>: <t t-esc="attribute.value"/>
                            </span>
                        </div>
                        <div t-if="line.note" class="o_prep_line_note" t-esc="line.note"/>
                        <div t-if="line.customer_note" class="o_prep_line_note" t-esc="line.customer_note"/>
                    </div>
                    <div t-if="line.cancelled" class="o_prep_line_cancelled">
                        <t t-esc="line.cancelled"/> cancelado(s)
                    </div>
                </div>
            </div>

            <div t-if="order.customer_note" class="o_prep_order_note">
                <strong>Nota:</strong> <t t-esc="order.customer_note"/>
            </div>
            <div t-if="order.internal_note.length" class="o_prep_order_note">
                <strong>Interna:</strong>
                <span t-foreach="order.internal_note" t-as="note" t-key="note"><t t-esc="note"/> </span>
            </div>

            <footer class="o_prep_card_actions">
                <button
                    t-if="!isCompleted"
                    class="btn btn-light"
                    t-on-click.stop="() => this.advance()"
                >
                    Avanzar
                </button>
                <button
                    t-if="!isCompleted"
                    class="btn btn-success"
                    t-on-click.stop="() => this.complete()"
                >
                    Completar
                </button>
                <button
                    class="btn btn-outline-secondary"
                    t-on-click.stop="() => this.reset()"
                >
                    Reiniciar
                </button>
            </footer>
        </article>
    </t>
</templates>
