<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_prep_display" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.prep.display</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_preparation_section']" position="inside">
                <setting
                    id="pos_prep_display_enabled_setting"
                    string="Preparation Display"
                    help="Send orders to kitchen and customer-facing preparation screens."
                >
                    <field name="pos_prep_display_enabled" readonly="pos_has_active_session"/>
                    <div class="content-group" invisible="not pos_prep_display_enabled">
                        <div class="mt8">
                            <button
                                name="%(action_pos_prep_display)d"
                                type="action"
                                string="Manage Preparation Displays"
                                icon="oi-arrow-right"
                                class="btn-link"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
